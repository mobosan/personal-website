---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParticleField from '../../components/interactive/ParticleField';
import Badge from '../../components/common/Badge.astro';
import { demos } from '../../data/demos';
import { ArrowUpRight } from '@lucide/astro';
export function getStaticPaths() {
  return demos.map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}
const { demo } = Astro.props;
---

<BaseLayout title={demo.title} description={demo.description} image={demo.cover}>
  <div class="container page-content">
    <div class="breadcrumb">
      <a href="/lab/">← 全部实验</a>
    </div>
    <header class="page-header" style="padding-top:24px">
      <span class="eyebrow">{demo.category} / EXPERIMENT</span>
      <h1>{demo.title}</h1>
      <p>{demo.description}</p>
    </header>
    <div class="demo-shell">
      <div class="demo-toolbar">
        <span>
          <i class="status-dot"></i>
          {demo.type === 'api' ? 'API / 尚未接入' : 'BROWSER / 本地运行'}
        </span>
        <Badge tone={demo.status === '可体验' ? 'green' : 'muted'}>{demo.status}</Badge>
        {demo.type !== 'api' && (
          <a
            class="text-link"
            href={demo.type === 'static' ? demo.url : '/demos/particle-field/'}
            target="_blank"
            rel="noopener noreferrer"
          >
            独立窗口 <ArrowUpRight size={14} />
          </a>
        )}
      </div>
      {demo.type === 'component' && (
        <>
          <ParticleField client:visible />
          <noscript>
            <p class="sample-notice">此实验需要 JavaScript。启用后可调整参数并播放动画。</p>
          </noscript>
        </>
      )}
      {demo.type === 'static' && <iframe
        class="demo-frame"
        title="渐变配色工作台"
        src={demo.url}
        loading="lazy"
        sandbox="allow-scripts allow-same-origin"
        allow="clipboard-write"
      ></iframe>}
      {demo.type === 'api' && (
        <div class="empty-state">
          <h2>想法正在酝酿，实验尚未上线。</h2>
          <p class="mt-3">当前没有连接模型或后端服务，不会收集输入或发起 API 请求。</p>
          <a href="/lab/particle-field/" class="button button-secondary mt-6">
            先体验粒子场 →
          </a>
        </div>
      )}
    </div>
    <section class="demo-notes">
      <h2>怎么玩</h2>
      <p>
        {demo.type === 'component'
          ? '移动鼠标或触碰画布，观察附近粒子的变化。拖动滑块修改参数，用暂停按钮仔细观察某一帧。键盘用户可以用 Tab 选中滑块，再用方向键调整。'
          : demo.type === 'static'
            ? '选择两个颜色，调整渐变角度，实时查看效果。点击复制 CSS 可将结果粘贴到项目中；如果浏览器限制剪贴板，可直接选中代码复制。'
            : '这个实验尚处于规划阶段。未来需要部署服务端接口，再添加超时、限流、错误处理与输入界面。'}
      </p>
      <h2>实验说明</h2>
      <p>
        {demo.type === 'component'
          ? '使用 React 与 Canvas 绘制，最多 150 个粒子。没有外部资源或数据上传，动画会响应减少动画偏好，并在后台停止。'
          : demo.type === 'static'
            ? '这是一个独立 HTML / CSS / JavaScript 应用，通过 iframe 接入。所有配色运算在浏览器完成。'
            : '本站是静态网站。模型密钥必须保存在未来的后端服务中，前端只能使用公开的服务地址。'}
      </p>
    </section>
  </div>
</BaseLayout>
