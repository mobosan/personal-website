---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import ArticleCard from '../components/blog/ArticleCard.astro';
import Orbital from '../components/common/Orbital.astro';
import Badge from '../components/common/Badge.astro';
import { ArrowRight, ArrowUpRight, FlaskConical, CodeXml } from '@lucide/astro';
import { getPosts, getProjects } from '../lib/content';
import { interests } from '../data/site';
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
const symbols = ['TS', '◈', '⚛', 'Py', '✦', '◇'];
---

<BaseLayout>
  <div class="container">
    <section class="hero">
      <div class="hero-copy">
        <p class="hero-kicker">
          <i class="status-dot"></i> A LITTLE CORNER OF THE INTERNET
        </p>
        <h1>
          探索技术，
          <br />
          <span>构建有趣的东西。</span>
        </h1>
        <p class="hero-description">
          记录 AI、游戏开发、Web 技术与个人项目实践。
          <br />
          在这里，让好奇心变成代码，让想法慢慢发生。
        </p>
        <div class="hero-actions">
          <Button href="/projects/">
            浏览项目 <ArrowUpRight size={16} />
          </Button>
          <Button href="/blog/" variant="secondary">
            阅读文章 <ArrowRight size={15} />
          </Button>
        </div>
        <p class="hero-note">
          <CodeXml size={13} /> 思考 · 实验 · 构建 · 分享
        </p>
      </div>
      <Orbital />
    </section>
    <div class="interest-strip">
      <span>保持好奇 / 当前关注</span>
      <div class="interest-list">
        {interests.map((tech, i) => (
          <span>
            <b class="tech-symbol">{symbols[i]}</b>
            {tech}
          </span>
        ))}
      </div>
    </div>
    <section class="section">
      <SectionHeading
        title="把想法，做成作品。"
        eyebrow="SELECTED PROJECTS"
        href="/projects/"
        linkText="全部项目"
      />
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
    <section class="section">
      <SectionHeading
        title="记录探索的过程。"
        eyebrow="LATEST WRITING"
        href="/blog/"
        linkText="全部文章"
      />
      <div class="article-list">
        {posts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </section>
    <section class="section">
      <SectionHeading
        title="不止于看，动手试试。"
        eyebrow="THE PLAYGROUND"
        href="/lab/"
        linkText="进入实验室"
      />
      <div class="lab-feature">
        <a href="/lab/particle-field/" class="lab-feature-art" aria-label="体验交互式粒子场">
          <img
            src="/images/particles.svg"
            alt="蓝紫粒子连接形成的星网示意图"
            width="700"
            height="380"
            loading="lazy"
          />
          <span class="live-label">
            <i class="status-dot"></i> INTERACTIVE / 001
          </span>
        </a>
        <div class="lab-feature-copy">
          <Badge tone="accent">
            <FlaskConical size={12} /> 创意编程
          </Badge>
          <h3>每一个点，都有无限可能。</h3>
          <p>移动指针，拨动一片粒子星网。调整密度与速度，看看简单的规则如何生长出复杂的美。</p>
          <Button href="/lab/particle-field/" variant="secondary">
            体验粒子场 <ArrowUpRight size={15} />
          </Button>
        </div>
      </div>
    </section>
    <section class="closing-note">
      <div>
        <h2>好的想法，往往从一次交流开始。</h2>
        <p>关于技术、创意，或者一个还没成形的点子。</p>
      </div>
      <a class="text-link" href="/about/">
        认识一下 <ArrowUpRight size={16} />
      </a>
    </section>
  </div>
</BaseLayout>
