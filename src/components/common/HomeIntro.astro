---
import { site } from '../../data/site';
---

<dialog
  id="home-intro"
  class="home-intro"
  aria-labelledby="intro-title"
  aria-describedby="intro-hint"
>
  <canvas aria-hidden="true"></canvas>
  <div class="intro-aura" aria-hidden="true"></div>
  <div class="intro-top" aria-hidden="true">
    <span>&gt;_ PERSONAL UNIVERSE</span>
    <span>EXPLORE / 001</span>
  </div>
  <div class="intro-copy">
    <p class="intro-eyebrow">A SPACE FOR ENDLESS POSSIBILITIES</p>
    <h2 id="intro-title">
      {site.name}
      <span>.</span>
    </h2>
    <p class="intro-tagline">让好奇心，成为新的可能。</p>
    <button class="intro-enter" type="button" data-intro-enter autofocus>
      <span class="intro-dot" aria-hidden="true"></span>
      <span id="intro-hint">点击任意位置，进入我的空间</span>
      <span aria-hidden="true">↗</span>
    </button>
    <p class="intro-key">也可以按 Enter 进入</p>
  </div>
  <div class="intro-bottom">
    <span class="intro-caption" aria-hidden="true">
      IDEAS · EXPERIMENTS · CREATIONS
    </span>
    <div class="intro-controls">
      <button type="button" data-intro-pause aria-pressed="false">
        暂停动画
      </button>
      <button type="button" data-intro-skip>
        跳过开场 <span aria-hidden="true">↗</span>
      </button>
    </div>
  </div>
</dialog>

<script>
  import { initHomeIntro } from './home-intro';
  initHomeIntro();
</script>

<style>
  .home-intro {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
    cursor: crosshair;
  }
  .home-intro[open] {
    display: grid;
    place-items: center;
  }
  .home-intro::backdrop {
    background: transparent;
  }
  canvas,
  .intro-aura {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .intro-aura {
    background: radial-gradient(ellipse at center, transparent 15%, var(--bg) 85%);
    opacity: 0.5;
  }
  .intro-copy {
    position: relative;
    text-align: center;
    max-width: 95vw;
    padding: 36px 14px;
    background: radial-gradient(ellipse, var(--bg), transparent 70%);
    transition:
      opacity 0.3s,
      transform 0.6s;
  }
  .intro-eyebrow {
    font: 9px var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.28em;
    margin: 0 0 26px;
  }
  h2 {
    font-size: clamp(36px, 7.2vw, 92px);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.06em;
    margin: 0;
  }
  h2 span {
    color: var(--accent);
  }
  .intro-tagline {
    color: var(--muted);
    letter-spacing: 0.18em;
    font-size: clamp(12px, 2.8vw, 15px);
    margin: 24px 0 40px;
  }
  .intro-enter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 14px 20px;
    min-height: 48px;
    background: var(--surface);
    color: var(--text);
    font-size: 12px;
  }
  .intro-enter:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
  }
  .intro-dot {
    width: 5px;
    height: 5px;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--cyan);
  }
  .intro-key {
    color: var(--subtle);
    font-size: 10px;
    letter-spacing: 0.1em;
    margin-top: 14px;
  }
  .intro-top,
  .intro-bottom {
    position: absolute;
    left: max(28px, env(safe-area-inset-left));
    right: max(28px, env(safe-area-inset-right));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .intro-top {
    top: max(28px, env(safe-area-inset-top));
    font: 10px var(--font-mono);
    color: var(--subtle);
    letter-spacing: 0.16em;
  }
  .intro-bottom {
    bottom: max(24px, env(safe-area-inset-bottom));
  }
  .intro-caption {
    color: var(--subtle);
    font: 9px var(--font-mono);
    letter-spacing: 0.18em;
  }
  .intro-controls {
    display: flex;
    gap: 10px;
  }
  .intro-controls button {
    background: var(--surface);
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 14px;
    min-height: 44px;
    font-size: 12px;
  }
  .intro-controls button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .home-intro[data-state='leaving'] {
    animation: intro-exit 1s ease-in both;
  }
  .home-intro[data-state='leaving'] .intro-copy {
    opacity: 0;
    transform: scale(1.12);
    pointer-events: none;
  }
  @keyframes intro-exit {
    0%,
    25% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @media (max-width: 600px) {
    .intro-top > :last-child,
    .intro-caption {
      display: none;
    }
    .intro-bottom {
      justify-content: center;
    }
    .intro-eyebrow {
      letter-spacing: 0.15em;
      font-size: 8px;
    }
  }
  @media (max-height: 480px) {
    .intro-tagline {
      margin: 12px 0 18px;
    }
    .intro-copy {
      padding: 10px;
    }
    h2 {
      font-size: 40px;
    }
    .intro-eyebrow {
      margin-bottom: 12px;
    }
    .intro-key {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-intro {
      display: none !important;
    }
  }
</style>
