---
import { ArrowUpRight } from '@lucide/astro';
interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  linkText?: string;
  description?: string;
}
const { title, eyebrow, href, linkText = '查看全部', description } = Astro.props;
---

<div class="section-heading">
  <div>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  {href && (
    <a class="text-link" href={href}>
      {linkText}
      <ArrowUpRight size={16} />
    </a>
  )}
</div>
